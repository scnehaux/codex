{
  "$id": "https://scnehaux.com/codex/gov/guidelines/schemas/tdd.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Technical Design Document (TDD) Validation Rules",
  "type": "object",
  "config": {
    "target_doc": "GDC-011-tdd-guideline.md"
  },
  "properties": {
    "filename": {
      "type": "string",
      "pattern": "^TDD-[a-z0-9-]+-[a-z0-9-]+-\\d{3}[A-Z]*-[a-z0-9-]+\\.md$"
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/metadata_rules"
    },
    {
      "$ref": "#/definitions/section_rules"
    },
    {
      "$ref": "#/definitions/content_rules"
    }
  ],
  "definitions": {
    "metadata_rules": {
      "title": "Metadata Rules",
      "description": "Rules for the YAML Frontmatter (doc_meta)",
      "required": ["doc_meta"],
      "properties": {
        "doc_meta": {
          "title": "Required Fields",
          "allOf": [
            {
              "$ref": "https://scnehaux.com/codex/gov/guidelines/schemas/base.schema.json#/definitions/common_metadata_fields"
            },
            {
              "type": "object",
              "required": [
                "owner",
                "version",
                "classification",
                "review_cycle_days",
                "last_reviewed",
                "parent_sad"
              ],
              "properties": {
                "status": {
                  "title": "Allowed Statuses",
                  "type": "string",
                  "enum": ["draft", "approved", "deprecated"]
                },
                "parent_sad": {
                  "title": "Parent SAD",
                  "type": ["string", "array"],
                  "items": { "type": "string" }
                }
              }
            }
          ]
        }
      }
    },
    "section_rules": {
      "title": "Section Rules",
      "description": "Rules for required and recommended sections in the Markdown body",
      "required": [
        "Purpose",
        "Scope",
        "Technical Context",
        "Component Design",
        "Data Model",
        "API / Interface",
        "Algorithms / Logic",
        "Configuration",
        "Testing Strategy",
        "Traceability"
      ],
      "recommended": [
        "Performance Notes",
        "Security Notes",
        "Operational Notes"
      ],
      "x-titles": {
        "required": "Required Sections",
        "recommended": "Recommended Sections"
      }
    },
    "content_rules": {
      "title": "Content Quality Rules",
      "description": "Rules for required and recommended keywords inside specific Markdown sections",
      "properties": {}
    }
  }
}
