{
  "$id": "https://scnehaux.com/codex/gov/guidelines/schemas/base.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Base Governance Rules",
  "type": "object",
  "config": {
    "target_doc": "GDC-001-fitness-functions.md"
  },
  "definitions": {
    "common_metadata_fields": {
      "title": "Common Metadata Fields",
      "type": "object",
      "required": ["id", "title", "status", "created_date"],
      "properties": {
        "id": {
          "title": "Document ID",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": ["string", "array"],
          "items": {
            "type": "string"
          }
        },
        "version": {
          "title": "Version",
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-zA-Z0-9-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-zA-Z0-9-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "error_message": "Must follow Semantic Versioning (e.g. 1.0.0)"
        },
        "status": {
          "title": "Allowed Statuses",
          "type": "string"
        },
        "classification": {
          "title": "Allowed Classifications",
          "type": "string",
          "enum": ["public", "internal", "restricted", "confidential"]
        },
        "review_cycle_days": {
          "title": "Review Cycle (Days)",
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "created_date": {
          "title": "Created Date",
          "type": "string",
          "format": "date"
        },
        "last_updated": {
          "title": "Last Updated Date",
          "type": "string",
          "format": "date"
        },
        "last_reviewed": {
          "title": "Last Reviewed Date",
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
