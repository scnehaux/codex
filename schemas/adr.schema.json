{
  "$id": "https://scnehaux.com/codex/gov/guidelines/schemas/adr.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architecture Decision Record (ADR) Validation Rules",
  "type": "object",
  "config": {
    "target_doc": "GDC-010-adr-guideline.md"
  },
  "properties": {
    "filename": {
      "type": "string",
      "pattern": "^ADR-[A-Z]{2,4}(?:-[A-Z]{2,4})?-\\d{3}-[a-z0-9-]+\\.md$"
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/metadata_rules"
    },
    {
      "$ref": "#/definitions/section_rules"
    },
    {
      "$ref": "#/definitions/content_rules"
    }
  ],
  "definitions": {
    "metadata_rules": {
      "title": "Metadata Rules",
      "description": "Rules for the YAML Frontmatter (doc_meta)",
      "required": ["doc_meta"],
      "properties": {
        "doc_meta": {
          "title": "Required Fields",
          "allOf": [
            {
              "$ref": "https://scnehaux.com/codex/gov/guidelines/schemas/base.schema.json#/definitions/common_metadata_fields"
            },
            {
              "type": "object",
              "required": ["adr_type", "created", "created_by"],
              "properties": {
                "status": {
                  "title": "Allowed Statuses",
                  "type": "string",
                  "enum": [
                    "proposed",
                    "accepted",
                    "rejected",
                    "superseded",
                    "deprecated"
                  ]
                },
                "adr_type": {
                  "title": "Allowed Types",
                  "type": "string",
                  "enum": [
                    "foundational",
                    "implementation",
                    "exception",
                    "conflict_resolution",
                    "replacement"
                  ]
                },
                "exception_info": {
                  "title": "Exception Information",
                  "type": "object",
                  "properties": {
                    "approved_by": { "type": "string" },
                    "expiry_date": { "type": "string" },
                    "risk_classification": { "type": "string" },
                    "exception_reason": { "type": "string" }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "adr_type": { "const": "exception" }
                }
              },
              "then": {
                "required": ["exception_info"],
                "properties": {
                  "exception_info": {
                    "required": [
                      "approved_by",
                      "expiry_date",
                      "risk_classification",
                      "exception_reason"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "section_rules": {
      "title": "Section Rules",
      "description": "Rules for required and recommended sections in the Markdown body",
      "required": [
        "Title",
        "Status",
        "Context",
        "Decision Drivers",
        "Decision",
        "Consequences",
        "Compliance Impact",
        "Alternatives Considered"
      ],
      "recommended": [],
      "x-titles": {
        "required": "Required Sections",
        "recommended": "Recommended Sections"
      }
    },
    "content_rules": {
      "title": "Content Quality Rules",
      "description": "Rules for required and recommended keywords inside specific Markdown sections",
      "properties": {}
    }
  }
}
